# Java middleware
MYSQL_ROOT_PASSWORD=123123
MYSQL_PORT=3306
APP_HTTP_PORT=8080
REGISTRY_MIRROR=m.daocloud.io/docker.io/library

# Optional AI (leave empty to disable key)
AI_ENABLED=true
AI_BASE_URL=https://ai.imge.cc.cd/v1
AI_API_KEY=
AI_MODEL=qwen/qwen3.5-35b-a3b

# Sonar + reports
SONAR_DB_PASSWORD=sonarpass
SONAR_HTTP_PORT=9000
REPORTS_HTTP_PORT=9080
CI_REPORTS_HOST_DIR=/opt/ci-reports

# Image pins (bootstrap may retag from China mirrors)
MYSQL_IMAGE=mysql:8.0
POSTGRES_IMAGE=postgres:15
SONAR_IMAGE=sonarqube:lts-community
NGINX_IMAGE=nginx:1.25-alpine
