<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>org.springframework.boot</groupId>
		<artifactId>spring-boot-starter-parent</artifactId>
		<version>2.2.2.RELEASE</version>
		<relativePath/> <!-- lookup parent from repository -->
	</parent>
	<groupId>com.jlwl</groupId>
	<!-- 导入项目的名称 否 -->
	<artifactId>springboot38hdw40x</artifactId>
	<version>0.0.1-SNAPSHOT</version>
	<name>springboot-schema</name>
	<description>springboot学习框架</description>

	<properties>
		<java.version>1.8</java.version>
		<fastjson.version>1.2.8</fastjson.version>
		<maven-jar-plugin.version>3.1.1</maven-jar-plugin.version>
		<mockito.version>4.11.0</mockito.version>
		<bytebuddy.version>1.14.12</bytebuddy.version>
		<!-- Override Boot 2.2 managed logback 1.2.3 (CVE-2023-6378). -->
		<!-- Keep 1.2.x: Spring Boot 2.2 expects SLF4J 1.7; logback 1.3+ needs SLF4J 2 and can fail startup. -->
		<logback.version>1.2.13</logback.version>
		<skipTests>false</skipTests>
		<!-- Sonar / JaCoCo (CI uploads coverage + issues to remote SonarQube) -->
		<sonar.projectKey>warehouse-management</sonar.projectKey>
		<sonar.projectName>Warehouse Management</sonar.projectName>
		<sonar.java.coveragePlugin>jacoco</sonar.java.coveragePlugin>
		<sonar.coverage.jacoco.xmlReportPaths>${project.build.directory}/site/jacoco/jacoco.xml</sonar.coverage.jacoco.xmlReportPaths>
		<sonar.sources>src/main/java,src/main/resources</sonar.sources>
		<sonar.tests>src/test/java</sonar.tests>
		<sonar.java.binaries>${project.build.directory}/classes</sonar.java.binaries>
		<sonar.java.source>1.8</sonar.java.source>
		<sonar.sourceEncoding>UTF-8</sonar.sourceEncoding>
		<sonar.exclusions>**/src/main/resources/admin/**,**/node_modules/**,**/static/**,**/*.min.js</sonar.exclusions>
		<sonar.coverage.exclusions>**/src/main/resources/**,**/dto/**,**/entity/**,**/config/**</sonar.coverage.exclusions>
		<!-- CPD: codegen CRUD boilerplate (entity/dao/vo/view/mapper/service.impl/controller) -->
		<sonar.cpd.exclusions>**/entity/**,**/dao/**,**/vo/**,**/view/**,**/mapper/**,**/service/impl/**,**/controller/**</sonar.cpd.exclusions>
	</properties>

